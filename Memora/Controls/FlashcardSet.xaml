<UserControl x:Class="Memora.Controls.FlashcardSet"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:local="clr-namespace:Memora.Controls"
             mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Button Style -->
        <Style TargetType="Button" x:Key="ButtonInsidePopUp">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FAFBFC"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="1"/>

            <!-- @See: https://stackoverflow.com/questions/20073294/change-color-of-button-when-mouse-is-over-->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4F46E5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- Pop up style-->
        <Style TargetType="Popup" x:Key="PopUpContent">
            <Setter Property="StaysOpen" Value="False"/>
            <Setter Property="Placement" Value="Left"/>
            <Setter Property="HorizontalOffset" Value="10"/>
            <Setter Property="VerticalOffset" Value="-20"/>
            <Setter Property="AllowsTransparency" Value="True"/>
        </Style>


        <!-- Animated border after clicking on the 3 dots-->
        <Style TargetType="Border" x:Key="AnimatedBorder">
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="BorderBrush" Value="#6366F1"/>
                <Setter Property="Background" Value="#6366F1"/>
                <Setter Property="Width" Value="65"/>

            <Style.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0" To="1"
                                             Duration="0:0:0.2"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
            
        </Style>

    </UserControl.Resources>


    <Grid Cursor="Hand">
        <Border Height="150"
                Width="150"
                CornerRadius="4"
                Margin="5"
                BorderThickness="1"
                BorderBrush="#DEE2E6"
                Background="Transparent">
            <!-- Handling pressing on the entire control -->
            <Border.InputBindings>
                <MouseBinding Gesture="LeftClick"
                              Command="{Binding FlashcardSetClickCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding CommandParameter, RelativeSource={RelativeSource AncestorType=UserControl}}">
                </MouseBinding>
            </Border.InputBindings>

            <StackPanel Orientation="Vertical"
                Margin="5"
                CanHorizontallyScroll="False">
                <!-- Three dots button in the top right corner -->
                <!-- AncestorType=UserControl looks for the DataContext of wherever the control is used-->
                <ToggleButton x:Name="FlashcardSetToggleButton"
                        Height="20"
                        Width="20"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Cursor="Hand"
                        Command="{Binding ThreeDotsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Grid Background="{TemplateBinding Background}">
                                            <ContentPresenter />
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ToggleButton.Style>
                        <StackPanel>
                        <!-- Three dots icon -->
                        <iconPacks:PackIconBootstrapIcons Kind="ThreeDots"
                                Height="15"
                                Width="15"
                                Margin="2"
                                Foreground="#4F46E5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Cursor="Hand">
                        </iconPacks:PackIconBootstrapIcons>
                        <!-- what appears after clicking the toggle button -->
                        <!-- The Binding to IsOpen checks whether the toggle button is pressed or not-->
                        <!-- @see https://learn.microsoft.com/en-us/dotnet/desktop/wpf/controls/popup-overview -->
                                <Popup Style="{StaticResource PopUpContent}"
                                       IsOpen="{Binding IsChecked, ElementName=FlashcardSetToggleButton}"
                                       PlacementTarget="{Binding ElementName=FlashcardSetToggleButton}">
                                    <Border Style="{StaticResource AnimatedBorder}">
                                <StackPanel Orientation="Vertical"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <Button Style="{StaticResource ButtonInsidePopUp}" 
                                            x:Name="Rename"
                                            Content="Rename"
                                            Click="Rename_Click"/>

                                    <Button Style="{StaticResource ButtonInsidePopUp}" 
                                            x:Name="Delete"
                                            Content="Delete"
                                            Command="{Binding DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding CommandParameter, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>


                </ToggleButton>

                <!-- Flashcard's set name -->
                <StackPanel Orientation="Vertical"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <!-- make text focusable via code behind -->
                    <!-- Key down here is pressing the "enter" button to accept a new flashcard set name -->
                    <TextBox x:Name="FlashcardSetName" Text="{Binding SetName, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                        BorderThickness="0"
                        Background="Transparent"
                        TextWrapping="Wrap"
                        Foreground="#2C3E50"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        FontSize="14"
                        FontWeight="Bold"
                        Margin="0"
                        Cursor="Hand"
                        Height="35"
                        TextAlignment="Center"
                        IsReadOnly="True"
                        KeyDown="FlashcardSetName_KeyDown">
                        
                    </TextBox>
                    <iconPacks:PackIconBootstrapIcons Kind="CardText"
                        Height="74"
                        Width="74"
                        Margin="2"
                        Foreground="#4F46E5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Cursor="Hand">
                    </iconPacks:PackIconBootstrapIcons>

                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
