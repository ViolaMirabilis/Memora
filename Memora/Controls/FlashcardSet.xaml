<UserControl x:Class="Memora.Controls.FlashcardSet"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:local="clr-namespace:Memora.Controls"
             mc:Ignorable="d">

    <UserControl.Resources>
        <Style TargetType="Button" x:Key="PopUpButton">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#FAFBFC"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="2"/>

            <!-- @See: https://stackoverflow.com/questions/20073294/change-color-of-button-when-mouse-is-over-->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4F46E5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>


    <Grid>

        <StackPanel Orientation="Vertical"
            Margin="5"
            CanHorizontallyScroll="False">
            <!-- Three dots button in the top right corner -->
            <!-- AncestorType=UserControl looks for the DataContext of wherever the control is used-->
            <ToggleButton x:Name="FlashcardSetToggleButton"
                    Height="20"
                    Width="20"
                    Background="Transparent"
                    BorderThickness="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Cursor="Hand"
                    Command="{Binding ThreeDotsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <StackPanel>
                    <!-- Three dots icon -->
                    <iconPacks:PackIconBootstrapIcons Kind="ThreeDots"
                            Height="15"
                            Width="15"
                            Margin="2"
                            Foreground="#4F46E5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Cursor="Hand">
                    </iconPacks:PackIconBootstrapIcons>
                    <!-- what appears after clicking the toggle button -->
                    <!-- The Binding to IsOpen checks whether the toggle button is pressed or not-->
                    <!-- @see https://learn.microsoft.com/en-us/dotnet/desktop/wpf/controls/popup-overview -->
                    <Popup IsOpen="{Binding IsChecked, ElementName=FlashcardSetToggleButton}"
                            StaysOpen="False"
                            PlacementTarget="{Binding ElementName=FlashcardSetToggleButton}"
                            Placement="Left"
                            AllowsTransparency="True">
                        <Border BorderThickness="2"
                                CornerRadius="5"
                                BorderBrush="#DEE2E6"
                                Background="#6366F1">
                            <StackPanel Orientation="Vertical"
                                        Width="auto"
                                        Height="auto">
                                <Button Style="{StaticResource PopUpButton}" 
                                        x:Name="Rename"
                                        Content="Rename"
                                        Command="{Binding RenameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>

                                <Button Style="{StaticResource PopUpButton}" 
                                        x:Name="Delete"
                                        Content="Delete"
                                        Command="{Binding DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>


            </ToggleButton>

            <!-- Flashcard's set name -->
            <StackPanel Orientation="Vertical"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <!-- make text focusable via code behind -->
                <TextBox Text="{Binding SetName}"
                    BorderThickness="0"
                    Background="Transparent"
                    TextWrapping="Wrap"
                    Foreground="#2C3E50"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    FontSize="14"
                    FontWeight="Bold"
                    Margin="0"
                    Cursor="Hand"
                    IsReadOnly="True"
                    Focusable="False"
                    Height="35"
                    TextAlignment="Center"/>
                <iconPacks:PackIconBootstrapIcons Kind="CardText"
                    Height="74"
                    Width="74"
                    Margin="2"
                    Foreground="#4F46E5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Cursor="Hand">
                </iconPacks:PackIconBootstrapIcons>

            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
