<UserControl x:Class="Memora.View.MyFlashcardSetDisplayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:local="clr-namespace:Memora.View"
             xmlns:controls="clr-namespace:Memora.Controls"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/LoadPageGridAnimation.xaml"/>
                <ResourceDictionary Source="/Themes/StudyModeButton.xaml"/>
                <ResourceDictionary Source="/Themes/SmallSquareButton.xaml"/>
                <ResourceDictionary Source="/Themes/SearchBar.xaml"/>
                <ResourceDictionary Source="/Themes/StudyModeButton.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>

    </UserControl.Resources>


    <Grid Style="{StaticResource LoadPageAnimation}">
        <Grid.RowDefinitions>
            <RowDefinition Height="0.10*"></RowDefinition>
            <RowDefinition Height="0.80*"></RowDefinition>
            <RowDefinition Height="0.10*"></RowDefinition>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.7*"/>
                <ColumnDefinition Width="0.3*"/>
            </Grid.ColumnDefinitions>
            <TextBox Style="{StaticResource SearchBar}"
                        Grid.Column="0"
                        Text="{Binding TextSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Tag="Search for a flashcard..."
                        HorizontalAlignment="Center"
                        HorizontalContentAlignment="Left"
                        VerticalAlignment="Center"
                        VerticalContentAlignment="Center"
                        Width="400"
                        Height="50"
                        Margin="10,2,10,2">
                </TextBox>

                <!-- new set label and button -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="10,2,10,2">

                <!-- New set and Import buttons -->
                    <Button Content="New set"
                            Style="{StaticResource StudyModeButton}"
                            Tag="{x:Static iconPacks:PackIconBootstrapIconsKind.Plus}"
                            Width="110"
                            Height="45"
                            Command="{Binding AddNewFlashcardSet}"
                            Margin="5"/>

                    <Button Content="Import"
                            Style="{StaticResource StudyModeButton}"
                            Tag="{x:Static iconPacks:PackIconBootstrapIconsKind.Download}"
                            Width="110"
                            Height="45"
                            Command="{Binding ImportFromTextCommand}"
                            Margin="5"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"/>

                </StackPanel>
        </Grid>


        
        <!-- Row 2-->
        <Border Grid.Column="1"
                Grid.Row="1"
                BorderBrush="#DEE2E6"
                BorderThickness="2"
                CornerRadius="4"
                Background="#FFFFFF"
                Margin="10">

            <!-- needed so the content can be stacked on top of each other-->
            <Grid>

                <ListView x:Name="FlashcardSetList" 
                      ItemsSource="{Binding FlashcardSetsView}"
                      Background="Transparent"
                      BorderThickness="0"
                      Margin="2"
                      Width="auto"
                      ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                      >

                    <!-- disables selection of the item -->

                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>


                    <!-- content of the list view is in the wrap panel -->
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Width="1100" Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>

                    <!-- each list view item is one custom control-->
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <!-- CommandParameter returns THIS object from the item source-->
                            <controls:FlashcardSet SetName="{Binding Name, Mode=TwoWay}"
                                               FlashcardSetClickCommand="{Binding DataContext.NavigateFlashcardDataCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                               CommandParameter="{Binding}"
                                               RenameCommand="{Binding DataContext.DisplayNewName, RelativeSource={RelativeSource AncestorType=ListView}}">
                            </controls:FlashcardSet>
                        </DataTemplate>
                    </ListView.ItemTemplate>

                </ListView>
            </Grid>
        </Border>


        <!-- OVERLAY -->
        <!-- Grid overlay with import from text window-->
        <Rectangle Grid.RowSpan="3"
           Width="auto"
           Height="auto"
           Visibility="{Binding IsImportOpen, Converter={StaticResource BoolToVisibility}}"
           Fill="Black"
           Opacity="0.5">
        </Rectangle>
        
        <!-- ImportFromText PopUp/Overlay -->
        <controls:ImportFromTextPopUp Grid.Row="1" Grid.RowSpan="3"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Visibility="{Binding IsImportOpen, Converter={StaticResource BoolToVisibility}}">
        </controls:ImportFromTextPopUp>


        <!-- Row 3-->

        <Label Grid.Row="2"
               Content="Page 1/7"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               FontSize="16"
               FontFamily="Sans Serif Collection"
               FontWeight="SemiBold"
               Foreground="#6366F1"
               Margin="2"></Label>
    </Grid>
</UserControl>
