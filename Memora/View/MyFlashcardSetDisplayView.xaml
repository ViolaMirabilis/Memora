<UserControl x:Class="Memora.View.MyFlashcardSetDisplayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:local="clr-namespace:Memora.View"
             xmlns:controls="clr-namespace:Memora.Controls"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/LoadPageGridAnimation.xaml"/>
                <ResourceDictionary Source="/Themes/StudyModeButton.xaml"/>
                <ResourceDictionary Source="/Themes/SmallSquareButton.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>

    </UserControl.Resources>


    <Grid Style="{StaticResource LoadPageAnimation}">
        <Grid.RowDefinitions>
            <RowDefinition Height="0.10*"></RowDefinition>
            <RowDefinition Height="0.80*"></RowDefinition>
            <RowDefinition Height="0.10*"></RowDefinition>
        </Grid.RowDefinitions>


        <!-- Row 1 -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="20,0,20,0">
            
            <Label Grid.Row="0"
                   Content="Create a new set"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="16"
                   FontFamily="Sans Serif Collection"
                   FontWeight="SemiBold"
                   Foreground="#6366F1"
                   Margin="2"></Label>

            <Button Content="+"
                    Style="{StaticResource SmallSquareButton}"
                    Tag="{x:Static iconPacks:PackIconBootstrapIconsKind.Plus}"
                    Command="{Binding AddNewFlashcardSet}"
                    Height="35"
                    Width="35"
                    FontSize="18"
                    Margin="4"
                    HorizontalAlignment="Right"/>
        </StackPanel>


<!-- Row 2-->
        <Border Grid.Column="1"
                Grid.Row="1"
                BorderBrush="#DEE2E6"
                BorderThickness="2"
                CornerRadius="4"
                Background="#FFFFFF"
                Margin="10">

            <ListView x:Name="FlashcardSetList" 
                      ItemsSource="{Binding FlashcardSets}"
                      Background="Transparent"
                      BorderThickness="0"
                      Margin="2"
                      Width="1000"
                      ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                      >
                
                <!-- disables selection of the item -->

                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                </ListView.ItemContainerStyle>


                <!-- content of the list view is in the wrap panel -->
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Width="1000" Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>

                <!-- each list view item is one custom control-->
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <!-- bind this to "DisplayNewName" -->
                        <controls:FlashcardSet SetName="{Binding Name}"
                                               RenameCommand="{Binding DataContext.DisplayNewName, RelativeSource={RelativeSource AncestorType=ListView}}"
                                               CommandParameter="{Binding}">
                        </controls:FlashcardSet>
                    </DataTemplate>
                </ListView.ItemTemplate>

                
                

            </ListView>
        </Border>
        
        <!-- Row 3-->

        <Label Grid.Row="2"
               Content="Page 1/7"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               FontSize="16"
               FontFamily="Sans Serif Collection"
               FontWeight="SemiBold"
               Foreground="#6366F1"
               Margin="2"></Label>
    </Grid>
</UserControl>
