<UserControl x:Class="Memora.Controls.ImportFromCodePopUp"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Memora.Controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d" >

    <UserControl.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/StudyModeButton.xaml"/>
                <ResourceDictionary Source="/Themes/SmallSquareButton.xaml"/>
                <ResourceDictionary Source="/Themes/AnimatedGrid.xaml"/>
                <ResourceDictionary Source="/Themes/LoadPageGridAnimation.xaml"/>
                <ResourceDictionary Source="/Themes/SearchBar.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>

    </UserControl.Resources>


    <Grid Height="250" Width="300">
        <Grid.RowDefinitions>
            <RowDefinition Height="0.6*"/>
            <RowDefinition Height="0.4*"/>
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="2"
        BorderBrush="#DEE2E6"
            Width="auto"
            BorderThickness="2"
            CornerRadius="10"
            Background="#FAFBFC"
            Margin="2">
        </Border>


        <Grid Grid.Row="0">
            <StackPanel Orientation="Vertical">
                <Button Content=""
                        Style="{StaticResource SmallSquareButton}"
                        Tag="{x:Static iconPacks:PackIconBootstrapIconsKind.X}"
                        Command="{Binding CloseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Height="25"
                        Width="25"
                        Margin="10,10,10,0"
                        FontSize="10"
                        HorizontalAlignment="Right">
                </Button>
                <Label Height="35"
                       Width="200"
                       Margin="3,0,3,3"
                       Content="Import flashcards from text"
                       FontFamily="Sans Serif Collection"
                       FontWeight="Bold"
                       FontSize="14"/>
                <!-- textbox -->
                <TextBox Style="{StaticResource SearchBar}"
                    Grid.Column="0"
                    TextWrapping="Wrap"
                    Text="{Binding CodeText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Tag="#CODE"
                    FontSize="16"
                    HorizontalAlignment="Center"
                    HorizontalContentAlignment="Left"
                    VerticalContentAlignment="Center"
                    Width="150"
                    Height="50"
                    Margin="5"/>
            </StackPanel>

        </Grid>

        <Grid Grid.Row="1">
            <!-- Import button -->

            <Button Content="Import"
            Style="{StaticResource StudyModeButton}"
            Tag="{x:Static iconPacks:PackIconBootstrapIconsKind.Download}"
            Width="125"
            Height="45"
            Command="{Binding ImportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
            Margin="5"/>
        </Grid>
    </Grid>
</UserControl>
