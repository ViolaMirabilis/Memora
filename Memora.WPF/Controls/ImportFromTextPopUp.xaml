<UserControl x:Class="Memora.Controls.ImportFromTextPopUp"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:local="clr-namespace:Memora.Controls"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/StudyModeButton.xaml"/>
                <ResourceDictionary Source="/Themes/SmallSquareButton.xaml"/>
                <ResourceDictionary Source="/Themes/AnimatedGrid.xaml"/>
                <ResourceDictionary Source="/Themes/LoadPageGridAnimation.xaml"/>
                <ResourceDictionary Source="/Themes/RoundedTextBox.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>

    </UserControl.Resources>


    <Grid Height="600" Width="500">
        <Grid.RowDefinitions>
            <RowDefinition Height="0.85*"/>
            <RowDefinition Height="0.15*"/>
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="2"
            BorderBrush="#DEE2E6"
                Width="auto"
                BorderThickness="2"
                CornerRadius="10"
                Background="#FAFBFC"
                Margin="5">
        </Border>


        <Grid Grid.Row="0">
            <StackPanel Orientation="Vertical">
                <Button Content="+"
                            Style="{StaticResource SmallSquareButton}"
                            Tag="{x:Static iconPacks:PackIconBootstrapIconsKind.X}"
                            Command="{Binding AddFlashcardCommand}"
                            Height="25"
                            Width="25"
                            Margin="10,10,10,0"
                            FontSize="10"
                            HorizontalAlignment="Right">
                </Button>
                <Label Height="35"
                           Width="200"
                           Margin="3,0,3,3"
                           Content="Import flashcards from text"
                           FontFamily="Sans Serif Collection"
                           FontWeight="Bold"
                           FontSize="14"/>
                <!-- textbox -->
                <TextBox x:Name="ImportedFlashcards" 
                         Style="{StaticResource RoundedTextBox}"
                        Grid.Column="0"
                        Text=""
                        TextWrapping="Wrap"
                        Tag="Front #1...    Back #1...&#10;Front #2...  Back #2...&#10;Front #3...  Back #3...&#10;"
                        FontSize="16"
                        HorizontalAlignment="Center"
                        HorizontalContentAlignment="Left"
                        VerticalContentAlignment="Top"
                        Width="450"
                        Height="425"
                        Margin="10"/>
            </StackPanel>

        </Grid>

        <Grid Grid.Row="1">
            <!-- flashcard separator and a button -->
            <!-- Command handles the bindable command and returns the textboxes content-->
            <StackPanel Orientation="Horizontal"
                        Margin="15,5,15,15"
                        HorizontalAlignment="Center">
                <TextBox x:Name="SeparatorChar" 
                Style="{StaticResource RoundedTextBox}"
                         MaxLength="3"
                Grid.Column="0"
                Text="{Binding Separator, RelativeSource={RelativeSource AncestorType=UserControl}}"
                TextWrapping="Wrap"
                FontFamily="Sans Serif Collection"
                Tag="Separator"
                FontSize="16"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Width="100"
                Height="50"
                Margin="5"/>
                <Button Content="Import"
                Style="{StaticResource StudyModeButton}"
                Tag="{x:Static iconPacks:PackIconBootstrapIconsKind.Download}"
                Width="125"
                Height="45"
                Command="{Binding ImportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                CommandParameter="{Binding ElementName=ImportedFlashcards, Path=Text}"
                Margin="5"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
