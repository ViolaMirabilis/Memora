<UserControl x:Class="Memora.View.MyFlashcardSetDataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Memora.View"
             xmlns:controls="clr-namespace:Memora.Controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:placeholder="clr-namespace:Memora.Design"
             d:DataContext="{d:DesignInstance Type=placeholder:MyFlashcardSetDataDesign, IsDesignTimeCreatable=True}"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/StudyModeButton.xaml"/>
                <ResourceDictionary Source="/Themes/GeneralConfirmButton.xaml"/>
                <ResourceDictionary Source="/Themes/SmallSquareButton.xaml"/>
                <ResourceDictionary Source="/Themes/AnimatedGrid.xaml"/>
                <ResourceDictionary Source="/Themes/LoadPageGridAnimation.xaml"/>
                <ResourceDictionary Source="/Themes/RoundedTextBox.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
        
    </UserControl.Resources>



    <Grid Style="{StaticResource LoadPageAnimation}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.7*"/>
            <ColumnDefinition Width="0.3*"/>
        </Grid.ColumnDefinitions>

        <!-- Left column -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <!-- flaschards count label -->
                <RowDefinition Height="auto"/>
                <!-- flashcards list view -->
                <RowDefinition Height="0.8*"/>
                <!-- add/confirm buttons-->
                <RowDefinition Height="0.1*"/>
            </Grid.RowDefinitions>

            <!-- Total flashcards count label -->
            <StackPanel Grid.Column="0"
                Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="2">

                <Label Content="{Binding FlashcardsCount}"
                        FontWeight="Bold"
                        FontSize="18"
                        Foreground="#2C3E50">
                </Label>
                <Label 
                        Content="Flashcards"
                        FontWeight="Bold"
                        FontSize="18"
                        Foreground="#2C3E50">
                </Label>
            </StackPanel>
            

            <!-- border around the flashcards -->
            <Border Grid.Row="1"
            BorderBrush="#DEE2E6"
            BorderThickness="2"
            CornerRadius="10"
            Background="#FAFBFC"
            Margin="20,0,10,5">

                <ListView
                    x:Name="FlashcardList" 
                    ItemsSource="{Binding ModifiedFlashcards}"
                    Background="Transparent"
                    BorderThickness="0"
                    Height="auto"
                    Width="auto"
                    Margin="15"
                    HorizontalAlignment="Center"
                    HorizontalContentAlignment="Center"
                    ItemContainerStyle="{StaticResource FlashcardDataDesign}"
                    ScrollViewer.CanContentScroll="True"
                    ScrollViewer.VerticalScrollBarVisibility="Visible"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Vertical"/>
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>

                </ListView>
            </Border>

            <!-- Stackpanel with buttons -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="+"
                        Style="{StaticResource SmallSquareButton}"
                        Tag="{x:Static iconPacks:PackIconBootstrapIconsKind.Plus}"
                        Command="{Binding AddFlashcardCommand}"
                        Height="45"
                        Width="45"
                        Margin="10">
                </Button>

                <Button Content="Save changes"
                            Style="{StaticResource GeneralConfirmButton}"
                            Command="{Binding SaveChanges}"
                            FontSize="14"
                            Height="45"
                            FontWeight="Regular">
                </Button>
            </StackPanel>

        </Grid>
        

        <!-- Right Column -->
        <!-- Sharing panel -->
        <StackPanel Grid.Column="2" VerticalAlignment="Top">
            <Grid >

                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="5,10,5,5">

                    <Button Content="🔗 Share this set?"
                          FontSize="20"
                          FontWeight="Regular"
                          Foreground="#2C3E50"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                        Focusable="False"
                           Cursor="Hand"
                           Command="{Binding ShareSetCommand}">
                        <Button.Template>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Grid Visibility="{Binding IsSharing, Converter={StaticResource BoolToVisibility}}" VerticalAlignment="Top" Margin="10">
                        <Border BorderThickness="2" BorderBrush="#DEE2E6" CornerRadius="10">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Visibility="Visible">

                                <TextBlock Text="#"
                                      FontSize="28"
                                      FontWeight="Bold"
                                      Foreground="#2C3E50"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                                <TextBox Text="{Binding SharingCode}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    HorizontalContentAlignment="Center"
                                    Height="50"
                                    Width="auto"
                                    FontSize="28"
                                    FontWeight="Bold"
                                    Margin="2"
                                    Foreground="#2C3E50"
                                    BorderThickness="0">
                                </TextBox>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Grid>
        </StackPanel>



        <StackPanel Grid.Column="1"
                    Orientation="Vertical"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Height="auto">

            <Border 
            Background="#FAFBFC"
            CornerRadius="10"
            VerticalAlignment="Bottom"
            BorderThickness="2"
            BorderBrush="#DEE2E6"
            Margin="10,10,10,10"
            Padding="10">

                <StackPanel Orientation="Vertical">

                    <Label Content="Settings"
                            Foreground="#2C3E50"
                            FontSize="28"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Center"
                            FontWeight="Bold"
                            Margin="10"></Label>
                    
                    <Button Content="Import"
                            Style="{StaticResource StudyModeButton}"
                            Tag="{x:Static iconPacks:PackIconBootstrapIconsKind.Download}"
                            Command="{Binding ToggleIsOpenCommand}"
                            Width="125"
                            Height="45"
                            Margin="5">
                    </Button>

                    <Button Content="Swap"
                            Style="{StaticResource StudyModeButton}"
                            Tag="{x:Static iconPacks:PackIconBootstrapIconsKind.ArrowLeftRight}"
                            Command="{Binding SwapFrontWithBackCommand}"
                            Width="125"
                            Height="45"
                            Margin="5">
                    </Button>
                    


                    <Label Content="Studying modes"
                   Foreground="#2C3E50"
                   FontSize="28"
                   VerticalAlignment="Top"
                   HorizontalAlignment="Center"
                   FontWeight="Bold"
                   Margin="10"></Label>

                    <Button Content="Revision"
                    Style="{StaticResource StudyModeButton}"
                    Tag="{x:Static iconPacks:PackIconBootstrapIconsKind.Book}"
                    Command="{Binding NavigateRevisionModeCommand}"
                    Width="125"
                    Height="45"
                    Margin="5"/>

                    <Button Content="Quiz"
                    Style="{StaticResource StudyModeButton}"
                    Tag="{x:Static
                iconPacks:PackIconBootstrapIconsKind.PatchQuestion}"
                    Width="125"
                    Height="45"
                    Command="{Binding NavigateQuizModeCommand}"
                    Margin="5"/>

                    <Button Content="Typing quiz"
                    Style="{StaticResource StudyModeButton}"
                    Tag="{x:Static iconPacks:PackIconBootstrapIconsKind.Keyboard}"
                    Command="{Binding}"
                    Width="125"
                    Height="45"
                    Margin="5"/>

                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Dimmed screen with an import pop up on top -->
        <Grid Grid.ColumnSpan="2"
              Visibility="{Binding IsImportOpen, Converter={StaticResource BoolToVisibility}}">
            <Rectangle Width="auto" Height="auto" Fill="Black" Opacity="0.3"></Rectangle>
            <!-- a pop up-->
            <controls:ImportFromTextPopUp
                Visibility="{Binding IsImportOpen, Converter={StaticResource BoolToVisibility}}"
                ImportCommand="{Binding ImportFlashcardsFromTextCommand}"
                ImportCommandParameter="{Binding}"
                CloseCommand="{Binding ToggleIsOpenCommand}"
                Separator="{Binding Separator, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">

            </controls:ImportFromTextPopUp>
        </Grid>
    </Grid>
</UserControl>
