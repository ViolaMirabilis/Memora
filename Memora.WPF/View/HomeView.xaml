<UserControl x:Class="Memora.View.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Memora.View"
             xmlns:controls="clr-namespace:Memora.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.3*"/>
            <RowDefinition Height="0.3*"/>
            <RowDefinition Height="0.3*"/>
        </Grid.RowDefinitions>

        <!-- welcome back text -->
        <StackPanel Orientation="Horizontal">
            <Label  Content="Welcome back, "
            FontSize="24"
            Foreground="#4F46E5"
            FontFamily="Sans Serif"
            FontWeight="Bold"
            Margin="15,5,0,0"
            HorizontalAlignment="Left"/>
            <Label  Content="Mirabilis!"
            FontSize="24"
            Foreground="#4F46E5"
            FontFamily="Sans Serif"
            FontWeight="Bold"
            Margin="0,5,0,0"/>
        </StackPanel>


        <!-- row 0, three columns-->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.3*"/>
                <ColumnDefinition Width="0.3*"/>
                <ColumnDefinition Width="0.3*"/>
            </Grid.ColumnDefinitions>


            
            <!-- border around DAY STREAK -->
            <Grid Grid.Row="0" Grid.Column="0">

                <!-- outer border with the shadow -->
                <Border BorderBrush="#DEE2E6"
                        BorderThickness="1"
                        CornerRadius="4"
                        Background="#FFFFFF"
                        Margin="15,50,15,10"
                        Height="100"
                        Width="350"
                        HorizontalAlignment="Left">
                    <Border.Effect>
                        <DropShadowEffect
                            Opacity="0.2"
                            Direction="270"
                            ShadowDepth="2"
                            BlurRadius="9"/>
                    </Border.Effect>
                </Border>

                <Border BorderBrush="Transparent"
                        BorderThickness="0"
                        CornerRadius="4"
                        Background="#FFFFFF"
                        Margin="15,50,15,10"
                        Height="100"
                        Width="350"
                        HorizontalAlignment="Left">

                    <StackPanel Orientation="Vertical"
                                Grid.Row="0"
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Height="75">
                        <!-- "Current streak" -->
                        <Label  Content="CURRENT STREAK"
                                FontSize="18"
                                Foreground="#4F46E5"
                                FontFamily="Sans Serif"
                                FontWeight="Bold"
                                Margin="7, 1,1,1"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"/>
                        <!-- amount of days -->
                        <StackPanel Orientation="Horizontal">
                            <Label  Content="2"
                                    FontSize="32"
                                    Foreground="#4F46E5"
                                    FontFamily="Sans Serif"
                                    FontWeight="Bold"
                                    Margin="7, 1, 1, 1"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"/>
                            <!-- "days"-->
                            <Label  Content="days"
                                    FontSize="12"
                                    Foreground="#4F46E5"
                                    FontFamily="Sans Serif"
                                    FontWeight="Bold"
                                    Margin="7, 1,1,1"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"/>
                        </StackPanel>

                    </StackPanel>

                </Border>
            </Grid>
            
            <!-- border around THIS WEEK -->

            <!-- border around DAY STREAK -->
            <Grid Grid.Row="0" Grid.Column="1">

                <!-- outer border with the shadow -->
                <Border BorderBrush="#DEE2E6"
                        BorderThickness="1"
                        CornerRadius="4"
                        Background="#FFFFFF"
                        Margin="15,50,15,10"
                        Height="100"
                        Width="350"
                        HorizontalAlignment="Left">
                    <Border.Effect>
                        <DropShadowEffect
                            Opacity="0.2"
                            Direction="270"
                            ShadowDepth="2"
                            BlurRadius="9"/>
                    </Border.Effect>
                </Border>

                <Border BorderBrush="Transparent"
                        BorderThickness="0"
                        CornerRadius="4"
                        Background="#FFFFFF"
                        Margin="15,50,15,10"
                        Height="100"
                        Width="350"
                        HorizontalAlignment="Left">

                    <StackPanel Orientation="Vertical"
                                Grid.Row="0"
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Height="75">
                        <!-- "Current streak" -->
                        <Label  Content="THIS WEEK"
                                FontSize="18"
                                Foreground="#4F46E5"
                                FontFamily="Sans Serif"
                                FontWeight="Bold"
                                Margin="7, 1,1,1"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"/>
                        <!-- amount of days -->
                        <StackPanel Orientation="Horizontal">
                            <Label  Content="47"
                                    FontSize="32"
                                    Foreground="#4F46E5"
                                    FontFamily="Sans Serif"
                                    FontWeight="Bold"
                                    Margin="7, 1, 1, 1"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"/>
                            <!-- "days"-->
                            <Label  Content="cards"
                                    FontSize="12"
                                    Foreground="#4F46E5"
                                    FontFamily="Sans Serif"
                                    FontWeight="Bold"
                                    Margin="7, 1,1,1"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"/>
                        </StackPanel>

                    </StackPanel>

                </Border>
            </Grid>

            <!-- border around THIS MONTH -->
            <Grid Grid.Row="0" Grid.Column="2">

                <!-- outer border with the shadow -->
                <Border BorderBrush="#DEE2E6"
                        BorderThickness="1"
                        CornerRadius="4"
                        Background="#FFFFFF"
                        Margin="15,50,15,10"
                        Height="100"
                        Width="350"
                        HorizontalAlignment="Left">
                    <Border.Effect>
                        <DropShadowEffect
                            Opacity="0.2"
                            Direction="270"
                            ShadowDepth="2"
                            BlurRadius="9"/>
                    </Border.Effect>
                </Border>

                <Border BorderBrush="Transparent"
                        BorderThickness="0"
                        CornerRadius="4"
                        Background="#FFFFFF"
                        Margin="15,50,15,10"
                        Height="100"
                        Width="350"
                        HorizontalAlignment="Left">

                    <StackPanel Orientation="Vertical"
                                Grid.Row="0"
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Height="75">
                        <!-- "Current streak" -->
                        <Label  Content="THIS MONTH"
                                FontSize="18"
                                Foreground="#4F46E5"
                                FontFamily="Sans Serif"
                                FontWeight="Bold"
                                Margin="7, 1,1,1"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"/>
                        <!-- amount of days -->
                        <StackPanel Orientation="Horizontal">
                            <Label  Content="215"
                                    FontSize="32"
                                    Foreground="#4F46E5"
                                    FontFamily="Sans Serif"
                                    FontWeight="Bold"
                                    Margin="7, 1, 1, 1"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"/>
                            <!-- "days"-->
                            <Label  Content="cards"
                                    FontSize="12"
                                    Foreground="#4F46E5"
                                    FontFamily="Sans Serif"
                                    FontWeight="Bold"
                                    Margin="7, 1,1,1"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"/>
                        </StackPanel>

                    </StackPanel>

                </Border>
            </Grid>



        </Grid>

        <!-- Border around the Recently Studied-->
        <Border Grid.Row="1" 
                BorderBrush="#DEE2E6"
                BorderThickness="2"
                CornerRadius="4"
                Background="#FFFFFF"
                Margin="15,10,15,10">
            <Border.Effect>
                <DropShadowEffect
                    Opacity="0.2"
                    Direction="270"
                    ShadowDepth="2"
                    BlurRadius="9"/>
            </Border.Effect>

            <StackPanel Grid.Row="1">
                <Label  Content="Recently studied"
                        FontSize="18"
                        Foreground="#4F46E5"
                        FontFamily="Sans Serif"
                        FontWeight="Bold"
                        Margin="5"/>

                <!-- copy pasted from another class. Should be remade into a custom control maybe? -->
                <ListView x:Name="FlashcardSetList" 
                          ItemsSource="{Binding FlashcardSets}"
                          Background="Transparent"
                          BorderThickness="0"
                          Margin="2"
                          Width="auto"
                          Height="auto"
                          HorizontalContentAlignment="Left"
                          ScrollViewer.CanContentScroll="False"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Hidden">

                    <!-- disables selection of the item -->
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>


                    <!-- content of the list view is in the wrap panel -->
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Width="1100" Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>

                    <!-- each list view item is one custom control-->
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <!-- CommandParameter returns THIS object from the item source-->
                            <controls:RecentFlashcardSet SetName="{Binding Name, Mode=TwoWay}"
                                                         SetCount="{Binding FlashcardsCount, Mode=TwoWay}"
                                                         FlashcardSetClickCommand="{Binding DataContext.NavigateFlashcardDataCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                         CommandParameter="{Binding}">
                            </controls:RecentFlashcardSet>
                        </DataTemplate>
                    </ListView.ItemTemplate>

                </ListView>
            </StackPanel>

        </Border>


        <Border Grid.Row="2" 
                BorderBrush="#DEE2E6"
                BorderThickness="2"
                CornerRadius="4"
                Background="#FFFFFF"
                Margin="15">
            <Border.Effect>
                <DropShadowEffect
                    Opacity="0.2"
                    Direction="270"
                    ShadowDepth="2"
                    BlurRadius="9"/>
            </Border.Effect>

            <Label  Content="This month's progress"
                    FontSize="18"
                    Foreground="#4F46E5"
                    FontFamily="Sans Serif"
                    FontWeight="Bold"
                    Margin="5"/>

        </Border>


    </Grid>
</UserControl>
